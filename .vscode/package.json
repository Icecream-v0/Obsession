{
  "name": "obsession-ai",
  "displayName": "I Have ADHD - ADHD-Friendly AI Responses",
  "description": "Transforms AI coding assistant responses to be ADHD-friendly: action-first, numbered steps, concrete next actions, no fluff.",
  "version": "1.0.0",
  "publisher": "ayghri",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "obsession-ai.toggle",
        "title": "Toggle ADHD-Friendly Mode",
        "category": "I Have ADHD"
      },
      {
        "command": "obsession-ai.enable",
        "title": "Enable ADHD-Friendly Mode",
        "category": "I Have ADHD"
      },
      {
        "command": "obsession-ai.disable",
        "title": "Disable ADHD-Friendly Mode",
        "category": "I Have ADHD"
      }
    ],
    "configuration": {
      "title": "I Have ADHD",
      "properties": {
        "obsession-ai.alwaysOn": {
          "type": "boolean",
          "default": false,
          "description": "Always apply ADHD-friendly formatting rules to AI responses"
        },
        "obsession-ai.showStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show status indicator in status bar when ADHD mode is active"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayghri/obsession-ai.git"
  },
  "license": "MIT"
}
