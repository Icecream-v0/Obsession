{
  "name": "i-have-adhd",
  "version": "1.0.0",
  "description": "Shape output for a reader with ADHD: lead with the next action, number multi-step work, restate state across turns, suppress tangents, give specific time estimates, make wins visible.",
  "license": "MIT",
  "homepage": "https://github.com/ayghri/i-have-adhd",
  "main": "extensions/i-have-adhd.ts",
  "bin": {
    "i-have-adhd": "./scripts/cli.js"
  },
  "files": [
    "extensions/",
    "skills/",
    "hooks/",
    "scripts/",
    ".vscode/",
    ".idea/",
    ".vim/",
    ".emacs/",
    ".zed/",
    ".cursor/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".opencode/",
    "plugin.json",
    "opencode.json",
    "kimi.plugin.json",
    "qwen-extension.json",
    "gemini-extension.json"
  ],
  "scripts": {
    "test": "python -m pytest tests/ -v",
    "build": "echo 'Building i-have-adhd package...'",
    "start": "node scripts/server.js",
    "deploy": "npm run build && npm publish",
    "website": "node scripts/website.js"
  },
  "keywords": ["pi-package", "adhd", "coding-assistant", "productivity", "vscode-extension", "jetbrains-plugin", "vim-plugin", "emacs-package"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ayghri/i-have-adhd.git"
  },
  "author": "ayghri",
  "omp": {
    "extensions": ["./extensions/i-have-adhd.ts"]
  },
  "pi": {
    "extensions": ["./extensions/i-have-adhd.ts"],
    "skills": ["./skills"]
  }
}
